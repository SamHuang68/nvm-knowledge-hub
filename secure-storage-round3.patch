   <script>
     // Studio Layout Vertical Rail Scroll Spy
     document.addEventListener('DOMContentLoaded', () => {
+      const layout = document.querySelector('.studio-layout');
+      const thesis = document.getElementById('thesis');
+      if (layout && thesis) {
+        const releaseRail = () => layout.classList.add('is-past-hero');
+        const railGate = new IntersectionObserver((entries) => {
+          if (entries.some((entry) => entry.isIntersecting || entry.boundingClientRect.top < window.innerHeight * 0.85)) {
+            releaseRail();
+            railGate.disconnect();
+          }
+        }, { threshold: 0, rootMargin: '0px 0px -15% 0px' });
+        railGate.observe(thesis);
+      }
+
       const railLinks = document.querySelectorAll('.lens-vertical-rail .lens-node-item');
