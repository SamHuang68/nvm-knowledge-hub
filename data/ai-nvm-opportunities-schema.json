{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvm-knowledge-hub.example/schemas/ai-nvm-opportunities-schema.json",
  "title": "AI NVM Opportunities Knowledge Package",
  "description": "Bilingual, SharePoint/Copilot-ready records that separate source requirements, first-party cases, technical evidence, vendor capability, architecture inference and validation gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "titleEn",
    "titleZh",
    "researchFreeze",
    "sourceDocument",
    "centralThesisEn",
    "centralThesisZh",
    "criticalBoundaryEn",
    "criticalBoundaryZh",
    "copilotAnswerRuleEn",
    "copilotAnswerRuleZh",
    "evidenceClassDefinitions",
    "researchInputs",
    "records"
  ],
  "properties": {
    "schemaVersion": { "const": "1.2" },
    "packageId": { "const": "AI-NVM-OPPORTUNITIES-2026-08-26" },
    "titleEn": { "type": "string", "minLength": 1 },
    "titleZh": { "type": "string", "minLength": 1 },
    "researchFreeze": { "type": "string", "format": "date" },
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "version", "date", "sha256"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
      }
    },
    "centralThesisEn": { "type": "string", "minLength": 1 },
    "centralThesisZh": { "type": "string", "minLength": 1 },
    "criticalBoundaryEn": { "type": "string", "minLength": 1 },
    "criticalBoundaryZh": { "type": "string", "minLength": 1 },
    "copilotAnswerRuleEn": { "type": "string", "minLength": 1 },
    "copilotAnswerRuleZh": { "type": "string", "minLength": 1 },
    "evidenceClassDefinitions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/evidenceClassDefinition" }
    },
    "researchInputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/researchInput" }
    },
    "records": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "evidenceClass": {
      "enum": [
        "DIRECT_REQUIREMENT",
        "FIRST_PARTY_CASE",
        "TECHNICAL_EVIDENCE",
        "VENDOR_CAPABILITY",
        "INFERRED_OPPORTUNITY",
        "VALIDATION_NEEDED"
      ]
    },
    "evidenceClassDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "labelEn", "labelZh", "definitionEn", "definitionZh"],
      "properties": {
        "code": { "$ref": "#/$defs/evidenceClass" },
        "labelEn": { "type": "string", "minLength": 1 },
        "labelZh": { "type": "string", "minLength": 1 },
        "definitionEn": { "type": "string", "minLength": 1 },
        "definitionZh": { "type": "string", "minLength": 1 }
      }
    },
    "researchInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputId",
        "title",
        "origin",
        "format",
        "pageCount",
        "sha256",
        "suppliedDate",
        "classification",
        "status",
        "citationStatus",
        "publicationStatus",
        "canonicalRecordEligible",
        "sourceLocator",
        "evidenceDispositionEn",
        "evidenceDispositionZh",
        "permittedUseEn",
        "permittedUseZh",
        "excludedUseEn",
        "excludedUseZh",
        "hypotheses"
      ],
      "properties": {
        "inputId": { "type": "string", "pattern": "^AI-NVM-INPUT-[A-Z0-9]+-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "origin": { "type": "string", "minLength": 1 },
        "format": { "const": "PDF" },
        "pageCount": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "suppliedDate": { "type": "string", "format": "date" },
        "classification": { "const": "Public" },
        "status": { "const": "UNVERIFIED_SYNTHESIS" },
        "citationStatus": { "const": "PRIMARY_SOURCES_NOT_DISCLOSED" },
        "publicationStatus": { "const": "RESEARCH_INTAKE_ONLY" },
        "canonicalRecordEligible": { "const": false },
        "sourceLocator": { "type": "string", "minLength": 1 },
        "evidenceDispositionEn": { "type": "string", "minLength": 1 },
        "evidenceDispositionZh": { "type": "string", "minLength": 1 },
        "permittedUseEn": { "type": "string", "minLength": 1 },
        "permittedUseZh": { "type": "string", "minLength": 1 },
        "excludedUseEn": { "type": "string", "minLength": 1 },
        "excludedUseZh": { "type": "string", "minLength": 1 },
        "hypotheses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/researchHypothesis" }
        }
      }
    },
    "researchHypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesisId",
        "titleEn",
        "titleZh",
        "status",
        "evidenceClass",
        "assuranceMaturity",
        "statementEn",
        "statementZh",
        "excludedClaimEn",
        "excludedClaimZh",
        "validationNeededEn",
        "validationNeededZh",
        "sourceLocator",
        "relatedRecordIds",
        "isInference",
        "canonicalRecordEligible",
        "proofModeEligible"
      ],
      "properties": {
        "hypothesisId": { "type": "string", "pattern": "^AI-NVM-HYP-[A-Z0-9]+-[0-9]{3}$" },
        "titleEn": { "type": "string", "minLength": 1 },
        "titleZh": { "type": "string", "minLength": 1 },
        "status": { "const": "VALIDATION_NEEDED" },
        "evidenceClass": { "const": "VALIDATION_NEEDED" },
        "assuranceMaturity": { "const": "Open" },
        "statementEn": { "type": "string", "minLength": 1 },
        "statementZh": { "type": "string", "minLength": 1 },
        "excludedClaimEn": { "type": "string", "minLength": 1 },
        "excludedClaimZh": { "type": "string", "minLength": 1 },
        "validationNeededEn": { "type": "string", "minLength": 1 },
        "validationNeededZh": { "type": "string", "minLength": 1 },
        "sourceLocator": { "type": "string", "minLength": 1 },
        "relatedRecordIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^AI-NVM-[A-Za-z0-9]+-[0-9]{3}$" }
        },
        "isInference": { "const": true },
        "canonicalRecordEligible": { "const": false },
        "proofModeEligible": { "const": false }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordId",
        "titleEn",
        "titleZh",
        "contentType",
        "topic",
        "asset",
        "attackClass",
        "lifecyclePhase",
        "claimEn",
        "claimZh",
        "claimStatus",
        "evidenceClass",
        "assuranceMaturity",
        "scope",
        "applicabilityEn",
        "applicabilityZh",
        "limitationEn",
        "limitationZh",
        "openQuestionEn",
        "openQuestionZh",
        "sourceUrl",
        "sourceOwner",
        "sourceLocator",
        "publishedDate",
        "reviewedDate",
        "owner",
        "classification",
        "audience",
        "presentationRole",
        "oipRelevanceEn",
        "oipRelevanceZh",
        "systemLayer",
        "persistenceClass",
        "storageCandidate",
        "opportunityStatus",
        "evidenceBoundaryEn",
        "evidenceBoundaryZh",
        "chapterRefs",
        "isInference",
        "proofModeEligible"
      ],
      "properties": {
        "recordId": { "type": "string", "pattern": "^AI-NVM-[A-Za-z0-9]+-[0-9]{3}$" },
        "titleEn": { "type": "string", "minLength": 1 },
        "titleZh": { "type": "string", "minLength": 1 },
        "contentType": {
          "enum": ["Requirement", "Proof Case", "Vendor Capability", "Architecture Inference", "Validation Gate"]
        },
        "topic": {
          "enum": [
            "Photonics & CPO",
            "Platform RAS",
            "Security & Trust",
            "Repair & Yield",
            "Power Management",
            "Interconnect",
            "NVM Selection",
            "Advanced-Node NVM"
          ]
        },
        "asset": {
          "enum": [
            "Device Identity",
            "Firmware State",
            "Repair State",
            "Calibration Profile",
            "Telemetry Evidence",
            "Boot Configuration",
            "Lifecycle Policy",
            "Management Configuration",
            "Persistent State"
          ]
        },
        "attackClass": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "lifecyclePhase": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["Manufacturing", "Provisioning", "Boot", "Runtime", "Service", "Update", "Attestation", "Retirement"]
          }
        },
        "claimEn": { "type": "string", "minLength": 1 },
        "claimZh": { "type": "string", "minLength": 1 },
        "claimStatus": {
          "enum": ["Public Requirement", "First-party Case", "Public Technical Evidence", "Vendor Claim", "Analyst Inference", "Validation Needed"]
        },
        "evidenceClass": { "$ref": "#/$defs/evidenceClass" },
        "assuranceMaturity": {
          "enum": ["Specified", "Demonstrated", "Vendor-stated", "Hypothesis", "Open"]
        },
        "scope": { "enum": ["IP", "Component", "Subsystem", "SoC", "Device", "Platform", "Ecosystem"] },
        "applicabilityEn": { "type": "string", "minLength": 1 },
        "applicabilityZh": { "type": "string", "minLength": 1 },
        "limitationEn": { "type": "string", "minLength": 1 },
        "limitationZh": { "type": "string", "minLength": 1 },
        "openQuestionEn": { "type": "string", "minLength": 1 },
        "openQuestionZh": { "type": "string", "minLength": 1 },
        "sourceUrl": {
          "oneOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        },
        "sourceOwner": { "type": "string", "minLength": 1 },
        "sourceLocator": { "type": "string", "minLength": 1 },
        "publishedDate": {
          "oneOf": [
            { "type": "string", "format": "date" },
            { "type": "null" }
          ]
        },
        "reviewedDate": { "type": "string", "format": "date" },
        "owner": { "type": "string", "minLength": 1 },
        "classification": { "const": "Public" },
        "audience": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "presentationRole": {
          "enum": ["System Need", "Proof Case", "Competitive Boundary", "Opportunity", "Validation Gate"]
        },
        "oipRelevanceEn": { "type": "string", "minLength": 1 },
        "oipRelevanceZh": { "type": "string", "minLength": 1 },
        "systemLayer": {
          "enum": [
            "Photonic Engine",
            "Platform Management",
            "Security & Trust",
            "Memory Repair",
            "Power Management",
            "Interconnect & Protocol",
            "Cross-layer"
          ]
        },
        "persistenceClass": { "enum": ["Immutable", "Bounded Mutable", "High-rate Stream", "External / Bulk", "Unspecified"] },
        "storageCandidate": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "OTP / Fuse",
              "PUF-derived Root",
              "MTP / Managed NVM",
              "EEPROM / Managed NVM",
              "Embedded Flash",
              "Embedded MRAM / RRAM",
              "External Flash / Host Storage",
              "Volatile State",
              "Not Specified"
            ]
          }
        },
        "opportunityStatus": {
          "enum": ["Source Requirement", "First-party Proof Case", "Technical Evidence", "Vendor Envelope", "Architecture Inference", "Validation Gate"]
        },
        "evidenceBoundaryEn": { "type": "string", "minLength": 1 },
        "evidenceBoundaryZh": { "type": "string", "minLength": 1 },
        "chapterRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(0[1-9]|10)$" }
        },
        "isInference": { "type": "boolean" },
        "proofModeEligible": { "type": "boolean" }
      }
    }
  }
}
