{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NVM Assurance Knowledge Record",
  "description": "SharePoint List / Copilot-ready metadata for governed NVM security knowledge.",
  "type": "object",
  "required": ["recordId", "title", "contentType", "topic", "asset", "attackClass", "lifecyclePhase", "claim", "claimStatus", "evidenceClass", "assuranceMaturity", "scope", "applicability", "limitation", "openQuestion", "sourceUrl", "sourceOwner", "reviewedDate", "owner", "classification", "audience", "presentationRole", "oipRelevance"],
  "properties": {
    "recordId": { "type": "string" },
    "title": { "type": "string" },
    "contentType": { "enum": ["Architecture", "Mechanism", "Case Study", "Evidence", "Platform Evidence", "System Inference", "Open Question", "Training"] },
    "topic": { "enum": ["Architecture", "Fault Injection", "Side-Channel Analysis", "Invasive Analysis", "Countermeasure", "Evidence", "Certification", "Training"] },
    "asset": { "enum": ["PUF Response", "Root Key", "Derived Key", "OTP Ciphertext", "Helper Data", "Lifecycle State", "Plaintext Window", "Controller Policy"] },
    "attackClass": { "type": "array", "items": { "enum": ["Power SCA", "EM SCA", "Timing", "Voltage Fault", "Clock Fault", "EM Fault", "Laser Fault", "Invasive Readout", "Protocol Abuse"] } },
    "lifecyclePhase": { "type": "array", "items": { "enum": ["Power-off", "Boot", "Derive", "Authorized Access", "Zeroize"] } },
    "claim": { "type": "string" },
    "claimStatus": { "enum": ["Public Fact", "Vendor Claim", "Analyst Inference", "Internally Tested", "Independently Evaluated", "Certified", "Field-proven", "Unknown"] },
    "evidenceClass": { "enum": ["Direct Observation", "Mechanism Evidence", "Vendor Disclosure", "Bounded Inference", "Unknown"] },
    "assuranceMaturity": { "enum": ["Claimed", "Specified", "Tested", "Independently Evaluated", "Certified", "Field-proven"] },
    "scope": { "enum": ["IP", "Subsystem", "SoC", "Device", "Organization"] },
    "applicability": { "type": "string" },
    "limitation": { "type": "string" },
    "openQuestion": { "type": "string" },
    "sourceUrl": { "type": "string", "format": "uri" },
    "sourceOwner": { "type": "string" },
    "publishedDate": { "type": ["string", "null"], "format": "date" },
    "reviewedDate": { "type": "string", "format": "date" },
    "owner": { "type": "string" },
    "classification": { "enum": ["Public", "Internal", "NDA"] },
    "certificationScheme": { "type": ["string", "null"] },
    "certificateOrReportId": { "type": ["string", "null"] },
    "productVersion": { "type": ["string", "null"] },
    "audience": { "type": "array", "items": { "type": "string" } },
    "presentationRole": { "enum": ["Problem", "Threat Evidence", "Architecture", "Lifecycle", "Consequence", "Platform Readiness", "Validation Gate", "Decision", "Appendix", null] },
    "oipRelevance": { "type": "string" },
    "copilotAnswerRule": { "const": "Return claim, claim status, evidence class, assurance maturity, source, scope, limitation, reviewed date and open question together." }
  }
}
